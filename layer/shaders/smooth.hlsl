[RootSignature(OVALFFR_RS)]
float4 VSMain(uint id : SV_VertexID) : SV_Position
{
    // one triangle that covers the whole target
    float2 uv = float2((id << 1) & 2, id & 2);
    return float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
}

// Same rule as ovalffr::make_mask(): evaluated at the centre of the tile the pixel is in.
uint RateLog2(uint2 p)
{
    uint2 t = p / g_tile;
    float x = ((float)t.x + 0.5) * (float)g_tile / (float)g_width;
    float y = ((float)t.y + 0.5) * (float)g_tile / (float)g_height;
    float ux = abs(x - g_cx) / g_ha;
    float uy = abs(y - g_cy) / g_hb;
    float s = pow(pow(ux, g_shape) + pow(uy, g_shape), 1.0 / g_shape);
    if (s <= 1.0) return 0;
    if (s <= 1.0 + g_band) return 1;
    return g_outer;
}

float4 Fetch(int2 p)
{
    p = clamp(p, int2(0, 0), int2((int)g_width - 1, (int)g_height - 1));
    return g_src.Load(int4(p, (int)g_slice, 0));
}

float MaxOf(float3 c) { return max(c.r, max(c.g, c.b)); }
float MaxOf4(float4 c) { return max(max(c.r, c.g), max(c.b, c.a)); }

// 1 = same surface, 0 = hard edge (ignore that neighbour). Compares every colour channel, so an
// orange object against a blue wall of the same brightness still counts as an edge.
float Similar(float3 a, float3 b)
{
    float d = MaxOf(abs(a - b)) / max(MaxOf(max(a, b)), 0.02);
    return saturate(1.0 - d / g_edge);
}

// A copied block has the same colour in every pixel. Compare with all four corners, so a corner
// pixel cannot pass just by matching itself, and a block an outline runs through is left alone.
bool CornersMatch(int2 p, int n, float4 own)
{
    int2 a = (p / n) * n;
    float4 dif = max(max(abs(own - Fetch(a)), abs(own - Fetch(a + int2(n - 1, n - 1)))),
                     max(abs(own - Fetch(a + int2(n - 1, 0))), abs(own - Fetch(a + int2(0, n - 1)))));
    return MaxOf4(dif) <= (1.0 / 512.0);
}

[RootSignature(OVALFFR_RS)]
float4 PSMain(float4 pos : SV_Position) : SV_Target
{
    int2 p = int2(pos.xy);
    uint l2 = RateLog2(uint2(p));
    if (l2 == 0) discard;                       // full-quality zone: never touched

    int n = 1 << l2;
    int2 anchor = (p / n) * n;
    float4 own = Fetch(p);
    if (!CornersMatch(p, n, own)) discard;      // not a copied block

    float2 f = (float2(p - anchor) + 0.5) / (float)n - 0.5;   // -0.5..0.5 inside the block
    int2 s = int2(f.x < 0.0 ? -1 : 1, f.y < 0.0 ? -1 : 1);
    float wx = abs(f.x);
    float wy = abs(f.y);

    float4 cX  = Fetch(p + int2(s.x * n, 0));
    float4 cY  = Fetch(p + int2(0, s.y * n));
    float4 cXY = Fetch(p + int2(s.x * n, s.y * n));

    float w0 = (1.0 - wx) * (1.0 - wy);
    float w1 = wx * (1.0 - wy) * Similar(own.rgb, cX.rgb);
    float w2 = (1.0 - wx) * wy * Similar(own.rgb, cY.rgb);
    float w3 = wx * wy * Similar(own.rgb, cXY.rgb);
    float3 blended = (own.rgb * w0 + cX.rgb * w1 + cY.rgb * w2 + cXY.rgb * w3) / (w0 + w1 + w2 + w3);
    return float4(lerp(own.rgb, blended, g_strength), own.a);
}

// One thread per 16x16 pixel cell: is the low-res block at the cell's corner an exact copy?
[RootSignature(OVALFFR_RS)]
[numthreads(8, 8, 1)]
void CSCount(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy) * 16;
    if (p.x >= (int)g_width || p.y >= (int)g_height) return;
    uint l2 = RateLog2(uint2(p));
    if (l2 == 0) return;
    int n = 1 << l2;                            // p is a multiple of 16, so it is a block corner
    float4 c0 = Fetch(p);
    bool same = true;
    [loop] for (int y = 0; y < n; ++y)
        [loop] for (int x = 0; x < n; ++x)
            if (MaxOf4(abs(Fetch(p + int2(x, y)) - c0)) > (1.0 / 512.0)) same = false;
    uint before;
    g_count.InterlockedAdd(0, 1, before);
    if (same) g_count.InterlockedAdd(4, 1, before);
}

uint GlyphAt(uint row, uint col)
{
    uint i = row * 32 + col;
    uint word = g_text[i / 16][(i / 4) % 4];
    return (word >> ((i % 4) * 8)) & 0xFF;
}

bool GlyphPixel(uint g, uint gx, uint gy)
{
    if (g >= (uint)FONT_COUNT) g = 0;
    uint2 w = kFont[g];
    uint bit = gy * 5 + gx;
    return gy < 4 ? ((w.x >> bit) & 1) != 0 : ((w.y >> (bit - 20)) & 1) != 0;
}

// Text box: white 5x7 letters on a dark, partly see-through background. Returns false outside it.
bool TextPixel(int2 p, out float4 colour)
{
    colour = float4(0, 0, 0, 0);
    uint len1 = g_lens & 0xFF, len2 = (g_lens >> 8) & 0xFF;
    uint lines = len2 > 0 ? 2 : 1;
    int s = (int)max(g_scale, 1u);
    int boxW = (int)max(len1, len2) * 6 * s + 5 * s;
    int boxH = (int)lines * 9 * s + 4 * s;
    int2 o = int2((int)(g_textX * (float)g_width) - boxW / 2, (int)(g_textY * (float)g_height));
    int2 q = p - o;
    if (q.x < 0 || q.y < 0 || q.x >= boxW || q.y >= boxH) return false;
    colour = float4(0.02, 0.02, 0.03, 0.70);
    int2 t = q - int2(3 * s, 3 * s);
    if (t.x < 0 || t.y < 0) return true;
    uint row = (uint)(t.y / (9 * s)), col = (uint)(t.x / (6 * s));
    uint gx = (uint)((t.x % (6 * s)) / s), gy = (uint)((t.y % (9 * s)) / s);
    uint len = row == 0 ? len1 : len2;
    if (row < lines && col < len && gx < 5 && gy < 7 && GlyphPixel(GlyphAt(row, col), gx, gy))
        colour = float4(1.0, 1.0, 1.0, 1.0);
    return true;
}

[RootSignature(OVALFFR_RS)]
float4 PSOverlay(float4 pos : SV_Position) : SV_Target
{
    int2 p = int2(pos.xy);
    float4 c;
    if ((g_flags & 1) != 0 && TextPixel(p, c)) return c;
    if ((g_flags & 2) != 0)
    {
        uint l2 = RateLog2(uint2(p));
        if (l2 > 0)
        {
            bool real = (g_flags & 4) == 0 || CornersMatch(p, 1 << l2, Fetch(p));
            float3 tint = !real ? float3(0.70, 0.20, 0.95) : (l2 == 1 ? float3(0.96, 0.76, 0.26) : float3(0.86, 0.24, 0.30));
            return float4(tint, 0.35);
        }
    }
    discard;
    return c;
}
