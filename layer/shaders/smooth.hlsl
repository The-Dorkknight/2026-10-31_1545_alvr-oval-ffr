// OvalFFR GPU passes (Direct3D 12, shader model 5.1, compiled at run time by d3dcompiler_47.dll,
// which ships with Windows 10 and 11). All run after the game has drawn an eye image, on the game's
// own queue, before the runtime reads the image.
//
//   PSMain    "Smooth low-res edge": turns the copied 2x2 / 4x4 blocks that Variable Rate Shading
//             produces into a bilinear upscale. Never writes the sharp area or a block that is not
//             an exact copy; ignores neighbours of clearly different colour (edge-preserving).
//   CSCount   "VRS check": looks at one block in every 16x16 pixels of the low-res zones and counts
//             how many really are exact copies. ~90 %+ means VRS is working on the image the headset
//             gets; near 0 % means the game drew that image at full detail (VRS not applied there).
//   PSOverlay the in-headset fps box and the zone highlight (yellow = 2x2, red = 4x4, purple = the
//             mask asks for low-res but the image there is full detail). Alpha-blended.
//
// tests/smooth_test.cpp runs a line-by-line C++ copy of this file (layer/src/ovalffr_smooth.cpp).
// Keep the two in step.

#define OVALFFR_RS "RootConstants(num32BitConstants=36, b0), DescriptorTable(SRV(t0, numDescriptors=1)), UAV(u0)"

cbuffer Params : register(b0)
{
    float g_cx;        // oval centre, 0..1 of the view (y down)
    float g_cy;
    float g_ha;        // half width / half height of the full-quality oval, 0..1 of the view
    float g_hb;
    float g_shape;     // superellipse exponent
    float g_band;      // 2x2 ring thickness
    float g_strength;  // 0..1
    float g_edge;      // relative colour difference treated as a hard edge
    uint  g_width;
    uint  g_height;
    uint  g_tile;      // shading-rate image tile size in pixels
    uint  g_outer;     // log2 of the outer rate (1 = 2x2, 2 = 4x4)
    uint  g_slice;     // array slice (eye) for array swapchains, otherwise 0
    uint  g_flags;     // 1 = text, 2 = zone highlight, 4 = the copy (g_src) is valid
    uint  g_lens;      // characters on line 1 (bits 0-7) and line 2 (bits 8-15)
    uint  g_scale;     // font pixel size in screen pixels
    float g_textX;     // centre of the text box, 0..1 of the view
    float g_textY;     // top of the text box, 0..1 of the view
    float g_pad0;
    float g_pad1;
    uint4 g_text[4];   // 2 lines x 32 glyph indices, 4 per uint, lowest byte first
};

Texture2DArray<float4> g_src : register(t0);   // copy of the eye image as the game left it
RWByteAddressBuffer g_count : register(u0);    // CSCount: [0] blocks looked at, [4] exact copies

